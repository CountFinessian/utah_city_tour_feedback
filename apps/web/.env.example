# --- Database ---
# When set, observations persist to Postgres (Neon). The Vercel Neon Marketplace
# integration provisions this automatically. With no value, the app falls back to
# a local JSON file (.data/) for development.
DATABASE_URL=
# ──────────────────────────────────────────────────
# Utah City — Environment Variables
# Copy this file to .env.local and fill in your values.
# See docs/ENVIRONMENT.md for full documentation.
# ──────────────────────────────────────────────────

# Manager view: weekly debrief target per host used to compute coverage.
# WEEKLY_TOUR_TARGET_PER_HOST=12
# ── Database ──────────────────────────────────────
# Neon Postgres pooled connection string. If omitted, data persists to local .data/ JSON files.
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# --- LLM (optional) ---
# The app runs fully without this: with no key it uses a deterministic heuristic
# extractor. Set a Vercel AI Gateway key to upgrade to Claude-quality extraction
# and an LLM-written leadership narrative.
AI_GATEWAY_API_KEY=
# ── AI / LLM (pick one provider — falls back to heuristic if none set) ──
# GEMINI_API_KEY=""
# GOOGLE_MODEL="gemini-3.8-flash"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-6"
# AI_GATEWAY_API_KEY=""
# EXTRACTION_MODEL="anthropic/claude-sonnet-4-6"
# NARRATIVE_MODEL="anthropic/claude-sonnet-4-6"

# Override the models routed through the gateway (provider/model strings).
# EXTRACTION_MODEL=anthropic/claude-sonnet-4-6
# NARRATIVE_MODEL=anthropic/claude-sonnet-4-6
# ── Speech-to-Text ───────────────────────────────
# On-device WASM Whisper works with no key (default). Set keys for faster server-side ASR.
# OPENAI_API_KEY=""
# ASR_MODEL="whisper-1"
# NEXT_PUBLIC_WHISPER_MODEL="Xenova/whisper-base.en"

# --- Speech-to-text ---
# Voice is transcribed ON-DEVICE by default (transformers.js Whisper in the browser) —
# no key required. Override the on-device model if you like:
# NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base.en   # or Xenova/whisper-tiny.en (lighter)
#
# Optional: set OPENAI_API_KEY to use faster server-side Whisper instead of on-device.
OPENAI_API_KEY=
# ASR_MODEL=whisper-1
# ── Email (Resend) ───────────────────────────────
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET=""
# EMAIL_FROM="Utah City <onboarding@utahcity.app>"
# SUPPORT_FORWARD_EMAIL="your-inbox@gmail.com"
# SUPPORT_FROM_EMAIL="Utah City Support <support@utahcity.app>"

# ── Authentication ───────────────────────────────
# HMAC-SHA256 secret for session signing. MUST be set in production.
# AUTH_SECRET="generate-a-random-64-char-hex-string"

# ── Application ──────────────────────────────────
# NEXT_PUBLIC_APP_URL="https://yourdomain.app"
# WEEKLY_TOUR_TARGET_PER_HOST="12"
