default_platform(:ios)

platform :ios do
  desc "Build and submit directly to the App Store for Review"
  lane :release do
    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    app_id = ENV["APP_IDENTIFIER"] || "com.utahcity.host"

    # Automatically create App Identifier & App in App Store Connect if not already present
    begin
      produce(
        api_key: api_key,
        app_identifier: app_id,
        app_name: "Utah City Tour Host",
        sku: "utahcityhost01",
        language: "en-US",
        skip_itc: false
      )
    rescue => ex
      UI.message("Notice during app creation: #{ex.message}")
    end

    # Fetch / generate Distribution Certificate
    get_certificates(
      api_key: api_key
    )

    # Fetch / generate App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa"
    )

    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      reject_if_possible: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    app_id = ENV["APP_IDENTIFIER"] || "com.utahcity.host"

    get_certificates(
      api_key: api_key
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build only (no upload) - for testing"
  lane :build_only do
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "development",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      skip_codesigning: true
    )
  end
end

