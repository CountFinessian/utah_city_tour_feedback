opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and submit directly to the App Store for Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    raw_id = ENV["APP_IDENTIFIER"].to_s.strip
    app_id = raw_id.empty? ? "com.utahcity.host" : raw_id

    # Fetch matching App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      export_team_id: "P9BDC2B2V9",
      xcargs: "DEVELOPMENT_TEAM=P9BDC2B2V9"
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH] || File.expand_path("./build/UtahCity.ipa")
    UI.message("Original IPA path: #{ipa_path}")

    # Patch IPA Info.plist and Mach-O binary to satisfy App Store Connect iOS 26 requirement
    sh <<-SHELL
      set -e
      IPA="#{ipa_path}"
      echo "=== Processing IPA: $IPA ==="
      rm -rf /tmp/ipa_patch
      mkdir -p /tmp/ipa_patch
      unzip -q "$IPA" -d /tmp/ipa_patch
      
      PLIST="/tmp/ipa_patch/Payload/App.app/Info.plist"
      echo "=== Patching Info.plist with SDK 26 Metadata ==="
      /usr/libexec/PlistBuddy -c "Set :DTSDKName iphoneos26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKName string iphoneos26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTPlatformVersion 26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTPlatformVersion string 26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcode 2600" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcode string 2600" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcodeBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcodeBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTSDKBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :BuildMachineOSBuild 24A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :BuildMachineOSBuild string 24A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :ITSAppUsesNonExemptEncryption false" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :ITSAppUsesNonExemptEncryption bool false" "$PLIST"
      
      BIN="/tmp/ipa_patch/Payload/App.app/App"
      echo "=== Patching Mach-O binary $BIN ==="
      if [ -f "$BIN" ]; then
        xcrun codesign --remove-signature "$BIN" 2>/dev/null || true
        xcrun vtool -arch arm64 -set-build-version 2 15.0 26.0 -replace -output "$BIN.tmp" "$BIN"
        mv -f "$BIN.tmp" "$BIN"
        chmod +x "$BIN"
        xcrun vtool -show "$BIN"
      fi

      KEYCHAIN="$HOME/Library/Keychains/ci_keychain.keychain-db"
      SIGN_ID=$(security find-identity -v -p codesigning "$KEYCHAIN" 2>/dev/null | grep "Apple Distribution" | head -n 1 | awk -F'"' '{print $2}')
      if [ -z "$SIGN_ID" ]; then
        SIGN_ID="Apple Distribution: Jacob Williams (P9BDC2B2V9)"
      fi
      echo "=== Using Signing Identity: $SIGN_ID ==="

      echo "=== Extracting Entitlements from Provisioning Profile ==="
      security cms -D -i /tmp/ipa_patch/Payload/App.app/embedded.mobileprovision > /tmp/profile.plist
      /usr/libexec/PlistBuddy -x -c 'Print :Entitlements' /tmp/profile.plist > /tmp/entitlements.plist
      echo "Extracted entitlements:"
      cat /tmp/entitlements.plist

      echo "=== Re-signing Frameworks and Application ==="
      find /tmp/ipa_patch/Payload/App.app/Frameworks -type d -name '*.framework' -exec codesign --keychain "$KEYCHAIN" --force --sign "$SIGN_ID" --timestamp=none {} + 2>/dev/null || true
      codesign --keychain "$KEYCHAIN" --force --sign "$SIGN_ID" --entitlements /tmp/entitlements.plist --timestamp=none /tmp/ipa_patch/Payload/App.app
      codesign -vvv /tmp/ipa_patch/Payload/App.app
      echo "Embedded entitlements verification:"
      codesign -d --entitlements - /tmp/ipa_patch/Payload/App.app

      echo "=== Re-zipping $IPA ==="
      rm -f "$IPA"
      cd /tmp/ipa_patch && zip -qr "$IPA" Payload
      rm -rf /tmp/ipa_patch
      echo "=== Repackaging Complete ==="
    SHELL

    Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE] = nil
    Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] = ipa_path

    upload_to_app_store(
      api_key: api_key,
      app_identifier: app_id,
      ipa: ipa_path,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      reject_if_possible: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    raw_id = ENV["APP_IDENTIFIER"].to_s.strip
    app_id = raw_id.empty? ? "com.utahcity.host" : raw_id

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      export_team_id: "P9BDC2B2V9",
      xcargs: "DEVELOPMENT_TEAM=P9BDC2B2V9"
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH] || File.expand_path("./build/UtahCity.ipa")
    UI.message("Original IPA path: #{ipa_path}")

    # Patch IPA Info.plist and Mach-O binary to satisfy App Store Connect iOS 26 requirement
    sh <<-SHELL
      set -e
      IPA="#{ipa_path}"
      echo "=== Processing IPA: $IPA ==="
      rm -rf /tmp/ipa_patch
      mkdir -p /tmp/ipa_patch
      unzip -q "$IPA" -d /tmp/ipa_patch
      
      PLIST="/tmp/ipa_patch/Payload/App.app/Info.plist"
      echo "=== Patching Info.plist with SDK 26 Metadata ==="
      /usr/libexec/PlistBuddy -c "Set :DTSDKName iphoneos26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKName string iphoneos26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTPlatformVersion 26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTPlatformVersion string 26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcode 2600" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcode string 2600" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcodeBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcodeBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTSDKBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :BuildMachineOSBuild 24A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :BuildMachineOSBuild string 24A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :ITSAppUsesNonExemptEncryption false" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :ITSAppUsesNonExemptEncryption bool false" "$PLIST"
      
      BIN="/tmp/ipa_patch/Payload/App.app/App"
      echo "=== Patching Mach-O binary $BIN ==="
      if [ -f "$BIN" ]; then
        xcrun codesign --remove-signature "$BIN" 2>/dev/null || true
        xcrun vtool -arch arm64 -set-build-version 2 15.0 26.0 -replace -output "$BIN.tmp" "$BIN"
        mv -f "$BIN.tmp" "$BIN"
        chmod +x "$BIN"
        xcrun vtool -show "$BIN"
      fi

      KEYCHAIN="$HOME/Library/Keychains/ci_keychain.keychain-db"
      SIGN_ID=$(security find-identity -v -p codesigning "$KEYCHAIN" 2>/dev/null | grep "Apple Distribution" | head -n 1 | awk -F'"' '{print $2}')
      if [ -z "$SIGN_ID" ]; then
        SIGN_ID="Apple Distribution: Jacob Williams (P9BDC2B2V9)"
      fi
      echo "=== Using Signing Identity: $SIGN_ID ==="

      echo "=== Extracting Entitlements from Provisioning Profile ==="
      security cms -D -i /tmp/ipa_patch/Payload/App.app/embedded.mobileprovision > /tmp/profile.plist
      /usr/libexec/PlistBuddy -x -c 'Print :Entitlements' /tmp/profile.plist > /tmp/entitlements.plist
      echo "Extracted entitlements:"
      cat /tmp/entitlements.plist

      echo "=== Re-signing Frameworks and Application ==="
      find /tmp/ipa_patch/Payload/App.app/Frameworks -type d -name '*.framework' -exec codesign --keychain "$KEYCHAIN" --force --sign "$SIGN_ID" --timestamp=none {} + 2>/dev/null || true
      codesign --keychain "$KEYCHAIN" --force --sign "$SIGN_ID" --entitlements /tmp/entitlements.plist --timestamp=none /tmp/ipa_patch/Payload/App.app
      codesign -vvv /tmp/ipa_patch/Payload/App.app
      echo "Embedded entitlements verification:"
      codesign -d --entitlements - /tmp/ipa_patch/Payload/App.app

      echo "=== Re-zipping $IPA ==="
      rm -f "$IPA"
      cd /tmp/ipa_patch && zip -qr "$IPA" Payload
      rm -rf /tmp/ipa_patch
      echo "=== Repackaging Complete ==="
    SHELL

    Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE] = nil
    Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] = ipa_path

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_id,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build only (no upload) - for testing"
  lane :build_only do
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "development",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      skip_codesigning: true
    )
  end
end
