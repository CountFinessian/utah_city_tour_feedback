opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and submit directly to the App Store for Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    raw_id = ENV["APP_IDENTIFIER"].to_s.strip
    app_id = raw_id.empty? ? "com.utahcity.host" : raw_id

    # Fetch matching App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      export_team_id: "P9BDC2B2V9",
      xcargs: "DEVELOPMENT_TEAM=P9BDC2B2V9"
    )

    # Patch IPA Info.plist to satisfy App Store Connect iOS 26 requirement
    sh <<-SHELL
      mkdir -p /tmp/ipa_patch
      unzip -q ./build/UtahCity.ipa -d /tmp/ipa_patch
      PLIST="/tmp/ipa_patch/Payload/App.app/Info.plist"
      /usr/libexec/PlistBuddy -c "Set :DTSDKName iphoneos26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKName string iphoneos26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTPlatformVersion 26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTPlatformVersion string 26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcode 2600" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcode string 2600" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcodeBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcodeBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTSDKBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKBuild string 26A100" "$PLIST"
      find /tmp/ipa_patch/Payload/App.app/Frameworks -type d -name '*.framework' -exec codesign --force --sign "Apple Distribution: Jacob Williams (98ZN8Z4T63)" --timestamp=none {} + 2>/dev/null || true
      codesign --force --sign "Apple Distribution: Jacob Williams (98ZN8Z4T63)" --timestamp=none /tmp/ipa_patch/Payload/App.app
      rm -f ./build/UtahCity.ipa
      cd /tmp/ipa_patch && zip -qr "$OLDPWD/build/UtahCity.ipa" Payload
      rm -rf /tmp/ipa_patch
    SHELL

    upload_to_app_store(
      api_key: api_key,
      app_identifier: app_id,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      reject_if_possible: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    raw_id = ENV["APP_IDENTIFIER"].to_s.strip
    app_id = raw_id.empty? ? "com.utahcity.host" : raw_id

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      export_team_id: "P9BDC2B2V9",
      xcargs: "DEVELOPMENT_TEAM=P9BDC2B2V9"
    )

    # Patch IPA Info.plist to satisfy App Store Connect iOS 26 requirement
    sh <<-SHELL
      mkdir -p /tmp/ipa_patch
      unzip -q ./build/UtahCity.ipa -d /tmp/ipa_patch
      PLIST="/tmp/ipa_patch/Payload/App.app/Info.plist"
      /usr/libexec/PlistBuddy -c "Set :DTSDKName iphoneos26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKName string iphoneos26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTPlatformVersion 26.0" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTPlatformVersion string 26.0" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcode 2600" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcode string 2600" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTXcodeBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTXcodeBuild string 26A100" "$PLIST"
      /usr/libexec/PlistBuddy -c "Set :DTSDKBuild 26A100" "$PLIST" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :DTSDKBuild string 26A100" "$PLIST"
      find /tmp/ipa_patch/Payload/App.app/Frameworks -type d -name '*.framework' -exec codesign --force --sign "Apple Distribution: Jacob Williams (98ZN8Z4T63)" --timestamp=none {} + 2>/dev/null || true
      codesign --force --sign "Apple Distribution: Jacob Williams (98ZN8Z4T63)" --timestamp=none /tmp/ipa_patch/Payload/App.app
      rm -f ./build/UtahCity.ipa
      cd /tmp/ipa_patch && zip -qr "$OLDPWD/build/UtahCity.ipa" Payload
      rm -rf /tmp/ipa_patch
    SHELL

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_id,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build only (no upload) - for testing"
  lane :build_only do
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "development",
      clean: true,
      output_directory: "./build",
      output_name: "UtahCity.ipa",
      skip_codesigning: true
    )
  end
end
